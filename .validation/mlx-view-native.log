2026-11-13T09:27:42.4079753Z     def test_concurrent_bridge_calls_are_serialized(self):
2026-11-13T09:27:42.4095244Z         """Concurrent bridge entry points must not race Metal command buffers."""
2026-11-13T09:27:42.4095596Z         script = """
2026-11-13T09:27:42.4095900Z from concurrent.futures import ThreadPoolExecutor
2026-11-13T09:27:42.4096228Z import torch
2026-11-13T09:27:42.4096445Z from sglang.srt.utils.tensor_bridge import mlx_call
2026-11-13T09:27:42.4096693Z 
2026-11-13T09:27:42.4096843Z source = torch.arange(8, device="mps", dtype=torch.float32)
2026-11-13T09:27:42.4097054Z 
2026-11-13T09:27:42.4097142Z def worker(iterations):
2026-11-13T09:27:42.4097335Z     for _ in range(iterations):
2026-11-13T09:27:42.4097582Z         result = mlx_call(lambda x: x + 1, source, device="mps")
2026-11-13T09:27:42.4097860Z         assert result.device.type == "mps"
2026-11-13T09:27:42.4098079Z         del result
2026-11-13T09:27:42.4098244Z     return True
2026-11-13T09:27:42.4098344Z 
2026-11-13T09:27:42.4098440Z with ThreadPoolExecutor(max_workers=2) as pool:
2026-11-13T09:27:42.4098732Z     futures = [pool.submit(worker, 64), pool.submit(worker, 64)]
2026-11-13T09:27:42.4099041Z     assert all(future.result() for future in futures)
2026-11-13T09:27:42.4099274Z """
2026-11-13T09:27:42.4099435Z         completed = subprocess.run(
2026-11-13T09:27:42.4099658Z             [sys.executable, "-c", script],
2026-11-13T09:27:42.4099897Z             capture_output=True,
2026-11-13T09:27:42.4100093Z             text=True,
2026-11-13T09:27:42.4100268Z             timeout=30,
2026-11-13T09:27:42.4100442Z             check=False,
2026-11-13T09:27:42.4100616Z         )
2026-11-13T09:27:42.4100780Z         self.assertEqual(
2026-11-13T09:27:42.4100981Z             completed.returncode,
2026-11-13T09:27:42.4101182Z             0,
2026-11-13T09:27:42.4101413Z             msg=f"stdout={completed.stdout}\nstderr={completed.stderr}",
2026-11-13T09:27:42.4101680Z         )
2026-11-13T09:27:42.4101761Z 
2026-11-13T09:27:42.4101891Z     def test_mlx_call_multi_rejects_non_sequence_output(self):
2026-11-13T09:27:42.4102199Z         source = torch.ones(2, device="mps", dtype=torch.float32)
2026-11-13T09:27:42.4102536Z         with self.assertRaisesRegex(TypeError, "non-empty tuple or list"):
