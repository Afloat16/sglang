2026-11-13T09:27:42.3963054Z     def test_cpu_conjugate_views_preserve_values_and_source(self):
2026-11-13T09:27:42.3963525Z         import mlx.core as mx
2026-11-13T09:27:42.3963654Z 
2026-11-13T09:27:42.3963779Z         real = torch.arange(12, dtype=torch.float32).reshape(3, 4)
2026-11-13T09:27:42.3964030Z         imaginary = real + 0.5
2026-11-13T09:27:42.3964278Z         source = torch.complex(real, imaginary).requires_grad_()
2026-11-13T09:27:42.3964545Z         tensor = source.conj().T
2026-11-13T09:27:42.3964790Z         expected = torch.complex(real.T, -imaginary.T)
2026-11-13T09:27:42.3965056Z         pointer = tensor.data_ptr()
2026-11-13T09:27:42.3965269Z         with mx.stream(mx.cpu):
2026-11-13T09:27:42.3965473Z             array = torch_to_mlx(tensor)
2026-11-13T09:27:42.3965704Z             actual = mlx_to_torch(array, device="cpu")
2026-11-13T09:27:42.3965867Z 
2026-11-13T09:27:42.3966005Z         torch.testing.assert_close(actual, expected, rtol=0, atol=0)
2026-11-13T09:27:42.3966311Z         self.assertEqual(actual.dtype, torch.complex64)
2026-11-13T09:27:42.3966583Z         self.assertFalse(actual.requires_grad)
2026-11-13T09:27:42.3966820Z         self.assertTrue(tensor.is_conj())
2026-11-13T09:27:42.3967059Z         self.assertEqual(tensor.data_ptr(), pointer)
2026-11-13T09:27:42.3967308Z         self.assertTrue(source.requires_grad)
2026-11-13T09:27:42.3967538Z         self.assertIsNone(source.grad)
2026-11-13T09:27:42.3967811Z         torch.testing.assert_close(source.real, real, rtol=0, atol=0)
2026-11-13T09:27:42.3968152Z         torch.testing.assert_close(source.imag, imaginary, rtol=0, atol=0)
2026-11-13T09:27:42.3968379Z 
2026-11-13T09:27:42.3968510Z     def test_cpu_negative_views_keep_values_and_precision(self):
2026-11-13T09:27:42.3968778Z         import mlx.core as mx
2026-11-13T09:27:42.3968896Z 
2026-11-13T09:27:42.3968999Z         for dtype in (torch.float32, torch.float64):
2026-11-13T09:27:42.3969239Z             with self.subTest(dtype=dtype):
2026-11-13T09:27:42.3969461Z                 imaginary = torch.tensor(
2026-11-13T09:27:42.3969698Z                     [0.25, -1.5, 3.25, 7.0, -2.5, 9.5], dtype=dtype
2026-11-13T09:27:42.3969927Z                 )
2026-11-13T09:27:42.3970158Z                 source = torch.complex(torch.ones_like(imaginary), imaginary)
2026-11-13T09:27:42.3970460Z                 tensor = source.conj().imag[1::2]
2026-11-13T09:27:42.3970809Z                 self.assertTrue(tensor.is_neg())
2026-11-13T09:27:42.3971067Z                 self.assertFalse(tensor.is_contiguous())
2026-11-13T09:27:42.3971324Z                 expected = -imaginary[1::2]
2026-11-13T09:27:42.3971547Z                 with mx.stream(mx.cpu):
2026-11-13T09:27:42.3971808Z                     actual = mlx_to_torch(torch_to_mlx(tensor), device="cpu")
2026-11-13T09:27:42.3972133Z                 torch.testing.assert_close(actual, expected, rtol=0, atol=0)
2026-11-13T09:27:42.3972433Z                 self.assertEqual(actual.dtype, dtype)
2026-11-13T09:27:42.3972675Z                 self.assertTrue(tensor.is_neg())
2026-11-13T09:27:42.3972981Z                 torch.testing.assert_close(source.imag, imaginary, rtol=0, atol=0)
2026-11-13T09:27:42.3973358Z 
2026-11-13T09:27:42.3973475Z     def test_cpu_calls_accept_lazy_view_inputs(self):
2026-11-13T09:27:42.3973728Z         import mlx.core as mx
2026-11-13T09:27:42.3973851Z 
2026-11-13T09:27:42.3974015Z         source = torch.tensor([1 + 2j, -3 + 4j, 0.5 - 1j], dtype=torch.complex64)
2026-11-13T09:27:42.3974310Z         with mx.stream(mx.cpu):
2026-11-13T09:27:42.3974591Z             product = mlx_call(lambda x: x * mx.conj(x), source.conj(), device="cpu")
2026-11-13T09:27:42.3975015Z             first, second = mlx_call_multi(
2026-11-13T09:27:42.3975288Z                 lambda x: (x + 2, x * 3), source.conj().imag, device="cpu"
2026-11-13T09:27:42.3975547Z             )
2026-11-13T09:27:42.3975720Z         torch.testing.assert_close(
2026-11-13T09:27:42.3976018Z             product, torch.tensor([5, 25, 1.25], dtype=torch.complex64), rtol=0, atol=0
2026-11-13T09:27:42.3976314Z         )
2026-11-13T09:27:42.3976475Z         torch.testing.assert_close(
2026-11-13T09:27:42.3976717Z             first, torch.tensor([0.0, -2.0, 3.0]), rtol=0, atol=0
2026-11-13T09:27:42.3976952Z         )
2026-11-13T09:27:42.3977108Z         torch.testing.assert_close(
2026-11-13T09:27:42.3977358Z             second, torch.tensor([-6.0, -12.0, 3.0]), rtol=0, atol=0
2026-11-13T09:27:42.3977612Z         )
2026-11-13T09:27:42.3977692Z 
2026-11-13T09:27:42.3977826Z     def test_cpu_lazy_view_import_owns_independent_storage(self):
2026-11-13T09:27:42.3978096Z         import mlx.core as mx
2026-11-13T09:27:42.3978215Z 
2026-11-13T09:27:42.3978304Z         for negative in (False, True):
2026-11-13T09:27:42.3978530Z             with self.subTest(negative=negative):
2026-11-13T09:27:42.3978819Z                 source = torch.tensor([1 + 2j, -3 + 4j], dtype=torch.complex64)
2026-11-13T09:27:42.3979147Z                 tensor = source.conj().imag if negative else source.conj()
2026-11-13T09:27:42.3979411Z                 expected = (
2026-11-13T09:27:42.3979612Z                     torch.tensor([-2.0, -4.0])
2026-11-13T09:27:42.3979834Z                     if negative
2026-11-13T09:27:42.3980078Z                     else torch.tensor([1 - 2j, -3 - 4j], dtype=torch.complex64)
2026-11-13T09:27:42.3980337Z                 )
2026-11-13T09:27:42.3980509Z                 with mx.stream(mx.cpu):
2026-11-13T09:27:42.3980733Z                     array = torch_to_mlx(tensor)
2026-11-13T09:27:42.3980950Z                     source.zero_()
2026-11-13T09:27:42.3981182Z                     actual = mlx_to_torch(array, device="cpu")
2026-11-13T09:27:42.3981489Z                 torch.testing.assert_close(actual, expected, rtol=0, atol=0)
2026-11-13T09:27:42.3981828Z                 self.assertEqual(torch.count_nonzero(source).item(), 0)
2026-11-13T09:27:42.3982024Z 
