2026-11-13T09:27:42.3990890Z @unittest.skipUnless(_HAS_SUPPORTED_RUNTIME, "requires MLX >= 0.32 and Torch MPS")
2026-11-13T09:27:42.3991460Z class TestTensorBridgeMetalSharing(unittest.TestCase):
2026-11-13T09:27:42.3991924Z     def test_common_inference_dtypes_round_trip_losslessly(self):
2026-11-13T09:27:42.3992320Z         import mlx.core as mx
2026-11-13T09:27:42.3992494Z 
2026-11-13T09:27:42.3992593Z         cases = [
2026-11-13T09:27:42.3992867Z             (torch.float32, mx.float32, [0.0, 1.0, -2.0]),
2026-11-13T09:27:42.3993414Z             (torch.float16, mx.float16, [0.0, 1.0, -2.0]),
2026-11-13T09:27:42.3993796Z             (torch.bfloat16, mx.bfloat16, [0.0, 1.0, -2.0]),
2026-11-13T09:27:42.3994159Z             (torch.int32, mx.int32, [0, 1, -2]),
2026-11-13T09:27:42.3994521Z             (torch.bool, mx.bool_, [False, True, False]),
2026-11-13T09:27:42.3994854Z         ]
2026-11-13T09:27:42.3995108Z         for torch_dtype, mlx_dtype, values in cases:
2026-11-13T09:27:42.3995478Z             with self.subTest(dtype=torch_dtype):
2026-11-13T09:27:42.3995909Z                 source = torch.tensor(values, device="mps", dtype=torch_dtype)
2026-11-13T09:27:42.3996342Z                 array = torch_to_mlx(source)
2026-11-13T09:27:42.3996673Z                 round_tripped = mlx_to_torch(array)
2026-11-13T09:27:42.3996910Z 
2026-11-13T09:27:42.3997051Z                 self.assertEqual(array.dtype, mlx_dtype)
2026-11-13T09:27:42.3997462Z                 self.assertEqual(round_tripped.dtype, torch_dtype)
2026-11-13T09:27:42.3997913Z                 self.assertEqual(round_tripped.device.type, "mps")
2026-11-13T09:27:42.3998395Z                 self.assertTrue(torch.equal(round_tripped.cpu(), source.cpu()))
2026-11-13T09:27:42.3998719Z 
2026-11-13T09:27:42.3998877Z     def test_torch_mps_to_mlx_is_an_explicit_copy(self):
2026-11-13T09:27:42.3999231Z         import mlx.core as mx
2026-11-13T09:27:42.3999402Z 
2026-11-13T09:27:42.3999594Z         tensor = torch.arange(24, device="mps", dtype=torch.float32)
2026-11-13T09:27:42.4000270Z         tensor = tensor.to(torch.bfloat16).reshape(4, 6).T
2026-11-13T09:27:42.4000640Z         expected = tensor.cpu().clone()
