2026-11-13T09:27:42.4055430Z     def test_mlx_call_multi_fences_and_evaluates_once(self):
2026-11-13T09:27:42.4055927Z         """A multi-output island must not evaluate each result independently."""
2026-11-13T09:27:42.4056361Z         import mlx.core as mx
2026-11-13T09:27:42.4056537Z 
2026-11-13T09:27:42.4056723Z         source = torch.arange(8, device="mps", dtype=torch.float32)
2026-11-13T09:27:42.4057124Z         source_before = source.cpu().clone()
2026-11-13T09:27:42.4057424Z         captured = {}
2026-11-13T09:27:42.4057657Z         events = []
2026-11-13T09:27:42.4057930Z         real_synchronize = torch.mps.synchronize
2026-11-13T09:27:42.4058259Z         real_eval = mx.eval
2026-11-13T09:27:42.4058573Z         real_from_dlpack = torch.utils.dlpack.from_dlpack
2026-11-13T09:27:42.4058970Z 
2026-11-13T09:27:42.4059082Z         def synchronize_then_record():
2026-11-13T09:27:42.4059388Z             real_synchronize()
2026-11-13T09:27:42.4059677Z             events.append("fence returned")
2026-11-13T09:27:42.4059902Z 
2026-11-13T09:27:42.4060010Z         def operation(x):
2026-11-13T09:27:42.4060276Z             events.append("operation")
2026-11-13T09:27:42.4060586Z             captured["arrays"] = (x + 1, x * 2)
2026-11-13T09:27:42.4060911Z             return list(captured["arrays"])
2026-11-13T09:27:42.4061133Z 
2026-11-13T09:27:42.4061247Z         def evaluate_and_record(*arrays):
2026-11-13T09:27:42.4061558Z             events.append("eval")
2026-11-13T09:27:42.4061848Z             return real_eval(*arrays)
2026-11-13T09:27:42.4062050Z 
2026-11-13T09:27:42.4062176Z         def import_and_record(*args, **kwargs):
2026-11-13T09:27:42.4062508Z             events.append("dlpack")
2026-11-13T09:27:42.4062826Z             return real_from_dlpack(*args, **kwargs)
2026-11-13T09:27:42.4063058Z 
2026-11-13T09:27:42.4063273Z         with (
2026-11-13T09:27:42.4063510Z             mock.patch.object(
2026-11-13T09:27:42.4063884Z                 torch.mps, "synchronize", side_effect=synchronize_then_record
2026-11-13T09:27:42.4064291Z             ) as synchronize,
2026-11-13T09:27:42.4064700Z             mock.patch.object(mx, "eval", side_effect=evaluate_and_record) as evaluate,
2026-11-13T09:27:42.4065155Z             mock.patch.object(
2026-11-13T09:27:42.4065430Z                 torch.utils.dlpack,
2026-11-13T09:27:42.4065726Z                 "from_dlpack",
2026-11-13T09:27:42.4066011Z                 side_effect=import_and_record,
2026-11-13T09:27:42.4066323Z             ) as from_dlpack,
2026-11-13T09:27:42.4066573Z         ):
2026-11-13T09:27:42.4066803Z             first, second = mlx_call_multi(
2026-11-13T09:27:42.4067125Z                 operation,
2026-11-13T09:27:42.4067366Z                 source,
2026-11-13T09:27:42.4067608Z                 device="mps",
2026-11-13T09:27:42.4067862Z             )
2026-11-13T09:27:42.4067992Z 
2026-11-13T09:27:42.4068112Z         synchronize.assert_called_once_with()
2026-11-13T09:27:42.4068445Z         self.assertEqual(
2026-11-13T09:27:42.4068686Z             events,
2026-11-13T09:27:42.4068997Z             ["fence returned", "operation", "eval", "dlpack", "dlpack"],
2026-11-13T09:27:42.4069372Z         )
2026-11-13T09:27:42.4069605Z         evaluate.assert_called_once()
2026-11-13T09:27:42.4069966Z         self.assertEqual(len(evaluate.call_args.args), 2)
2026-11-13T09:27:42.4070358Z         self.assertEqual(from_dlpack.call_count, 2)
2026-11-13T09:27:42.4070780Z         torch.testing.assert_close(first.cpu(), source_before + 1)
2026-11-13T09:27:42.4071251Z         torch.testing.assert_close(second.cpu(), source_before * 2)
2026-11-13T09:27:42.4071815Z         self.assertEqual(first.device.type, "mps")
2026-11-13T09:27:42.4072210Z         self.assertEqual(second.device.type, "mps")
2026-11-13T09:27:42.4072459Z 
2026-11-13T09:27:42.4072686Z         # Mutation through the Torch result remains visible from the original
2026-11-13T09:27:42.4073357Z         # MLX result allocation, proving that the positive-stride export did
2026-11-13T09:27:42.4073788Z         # not insert a copy.
2026-11-13T09:27:42.4074058Z         first.fill_(7)
2026-11-13T09:27:42.4074317Z         torch.mps.synchronize()
2026-11-13T09:27:42.4074676Z         self.assertTrue(mx.all(captured["arrays"][0] == 7).item())
2026-11-13T09:27:42.4074968Z 
2026-11-13T09:27:42.4075207Z     def test_mlx_call_multi_keeps_borrowed_inputs_alive_until_all_exports(self):
