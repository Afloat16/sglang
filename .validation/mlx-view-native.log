2026-11-13T09:27:42.4106120Z     def test_mlx_call_multi_sync_failure_precedes_graph_build(self):
2026-11-13T09:27:42.4106403Z         source = torch.ones(1, device="mps")
2026-11-13T09:27:42.4106623Z         operation = mock.Mock()
2026-11-13T09:27:42.4106751Z 
2026-11-13T09:27:42.4106825Z         with (
2026-11-13T09:27:42.4107001Z             mock.patch.object(
2026-11-13T09:27:42.4107297Z                 torch.mps,
2026-11-13T09:27:42.4107527Z                 "synchronize",
2026-11-13T09:27:42.4107960Z                 side_effect=RuntimeError("producer fence failed"),
