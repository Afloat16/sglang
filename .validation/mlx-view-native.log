2026-11-13T09:27:42.4013011Z         result = mlx_call(lambda x, w: mx.fast.rms_norm(x, w, 1e-6), tensor, weight)
2026-11-13T09:27:42.4013507Z 
2026-11-13T09:27:42.4013616Z         torch.mps.synchronize()
2026-11-13T09:27:42.4013961Z         self.assertTrue(torch.equal(tensor.cpu(), before))
2026-11-13T09:27:42.4014409Z         self.assertTrue(torch.equal(weight.cpu(), weight_before))
2026-11-13T09:27:42.4014892Z         self.assertNotEqual(result.data_ptr(), tensor.data_ptr())
2026-11-13T09:27:42.4015175Z 
2026-11-13T09:27:42.4015282Z         del tensor, weight
2026-11-13T09:27:42.4015535Z         gc.collect()
2026-11-13T09:27:42.4015837Z         torch.testing.assert_close(result.cpu(), reference)
