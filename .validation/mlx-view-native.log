2026-11-13T09:27:42.4138055Z 
2026-11-13T09:27:42.4138118Z         del array
2026-11-13T09:27:42.4138279Z         gc.collect()
2026-11-13T09:27:42.4138494Z         self.assertEqual(torch.count_nonzero(tensor).item(), 0)
2026-11-13T09:27:42.4138681Z 
2026-11-13T09:27:42.4138826Z     def test_negative_stride_views_materialize_without_aborting(self):
2026-11-13T09:27:42.4139099Z         script = """
2026-11-13T09:27:42.4139267Z import mlx.core as mx
2026-11-13T09:27:42.4139437Z import torch
2026-11-13T09:27:42.4139663Z from sglang.srt.utils.tensor_bridge import mlx_call, mlx_to_torch
2026-11-13T09:27:42.4139865Z 
2026-11-13T09:27:42.4139979Z expected = torch.arange(15, -1, -1, dtype=torch.float32)
2026-11-13T09:27:42.4140233Z for target in ("cpu", "mps"):
2026-11-13T09:27:42.4140442Z     array = mx.arange(16, dtype=mx.float32)[::-1]
2026-11-13T09:27:42.4140694Z     tensor = mlx_to_torch(array, device=target)
2026-11-13T09:27:42.4140970Z     torch.testing.assert_close(tensor.cpu(), expected)
2026-11-13T09:27:42.4141222Z     tensor.zero_()
2026-11-13T09:27:42.4141391Z     if target == "mps":
2026-11-13T09:27:42.4141575Z         torch.mps.synchronize()
2026-11-13T09:27:42.4141854Z     assert mx.array_equal(array, mx.arange(16, dtype=mx.float32)[::-1]).item()
2026-11-13T09:27:42.4142080Z 
2026-11-13T09:27:42.4142151Z with mx.stream(mx.cpu):
2026-11-13T09:27:42.4142350Z     array = mx.arange(16).astype(mx.float64)[::-1]
2026-11-13T09:27:42.4142593Z tensor = mlx_to_torch(array, device="cpu")
2026-11-13T09:27:42.4142816Z torch.testing.assert_close(
2026-11-13T09:27:42.4143042Z     tensor, torch.arange(15, -1, -1, dtype=torch.float64)
2026-11-13T09:27:42.4143669Z )
2026-11-13T09:27:42.4143809Z try:
2026-11-13T09:27:42.4143970Z     mlx_to_torch(array, device="mps")
2026-11-13T09:27:42.4144182Z except ValueError as exc:
2026-11-13T09:27:42.4144374Z     assert "float64" in str(exc)
2026-11-13T09:27:42.4144567Z else:
2026-11-13T09:27:42.4144799Z     raise AssertionError("float64 MLX export to MPS must fail explicitly")
2026-11-13T09:27:42.4145031Z 
2026-11-13T09:27:42.4145155Z source = torch.arange(16, device="mps", dtype=torch.float32)
2026-11-13T09:27:42.4145460Z result = mlx_call(lambda x: x[::-1], source, device="mps")
2026-11-13T09:27:42.4145747Z torch.testing.assert_close(result.cpu(), expected)
2026-11-13T09:27:42.4145970Z """
2026-11-13T09:27:42.4146125Z         completed = subprocess.run(
2026-11-13T09:27:42.4146338Z             [sys.executable, "-c", script],
2026-11-13T09:27:42.4146555Z             capture_output=True,
2026-11-13T09:27:42.4146744Z             text=True,
2026-11-13T09:27:42.4146912Z             timeout=30,
2026-11-13T09:27:42.4147081Z             check=False,
2026-11-13T09:27:42.4147247Z         )
2026-11-13T09:27:42.4147400Z         self.assertEqual(
2026-11-13T09:27:42.4147584Z             completed.returncode,
2026-11-13T09:27:42.4147774Z             0,
2026-11-13T09:27:42.4148113Z             msg=f"stdout={completed.stdout}\nstderr={completed.stderr}",
2026-11-13T09:27:42.4148382Z         )
2026-11-13T09:27:42.4148466Z 
2026-11-13T09:27:42.4148469Z 
2026-11-13T09:27:42.4148547Z if __name__ == "__main__":
2026-11-13T09:27:42.4148725Z     unittest.main()
2026-11-13T09:27:42.4148828Z 
2026-11-13T09:27:42.4148892Z END_FORMATTED_TEST
