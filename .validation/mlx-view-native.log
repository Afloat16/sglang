2026-11-13T09:27:42.3944623Z 
2026-11-13T09:27:42.3944847Z         source = torch.tensor([1.25, -2.5, 4.0, 8.0], dtype=torch.float64)
2026-11-13T09:27:42.3945414Z         with mock.patch.object(mx, "eval", wraps=mx.eval) as evaluate:
2026-11-13T09:27:42.3945871Z             first, second = mlx_call_multi(
2026-11-13T09:27:42.3946223Z                 lambda x: (x + 1, x * 2),
2026-11-13T09:27:42.3946549Z                 source,
2026-11-13T09:27:42.3946816Z                 device="cpu",
2026-11-13T09:27:42.3947102Z             )
2026-11-13T09:27:42.3947250Z 
2026-11-13T09:27:42.3947386Z         evaluate.assert_called_once()
2026-11-13T09:27:42.3947749Z         self.assertEqual(first.dtype, torch.float64)
2026-11-13T09:27:42.3948180Z         self.assertEqual(second.dtype, torch.float64)
2026-11-13T09:27:42.3948609Z         torch.testing.assert_close(first, source + 1)
2026-11-13T09:27:42.3949029Z         torch.testing.assert_close(second, source * 2)
2026-11-13T09:27:42.3949297Z 
2026-11-13T09:27:42.3949536Z     def test_mlx_call_multi_materializes_cpu_negative_strides_safely(self):
2026-11-13T09:27:42.3950024Z         import mlx.core as mx
2026-11-13T09:27:42.3950220Z 
2026-11-13T09:27:42.3950374Z         source = torch.arange(8, dtype=torch.float32)
2026-11-13T09:27:42.3950861Z         with mock.patch.object(mx, "eval", wraps=mx.eval) as evaluate:
2026-11-13T09:27:42.3951340Z             first, reversed_ = mlx_call_multi(
2026-11-13T09:27:42.3951789Z                 lambda x: (x + 1, x[::-1]), source, device="cpu"
2026-11-13T09:27:42.3952164Z             )
2026-11-13T09:27:42.3952295Z 
2026-11-13T09:27:42.3952535Z         # The ordinary graph is evaluated once; all negative-stride results
2026-11-13T09:27:42.3953326Z         # share one additional materialization boundary before DLPack export.
2026-11-13T09:27:42.3953793Z         self.assertEqual(evaluate.call_count, 2)
2026-11-13T09:27:42.3954193Z         torch.testing.assert_close(first, source + 1)
2026-11-13T09:27:42.3954648Z         torch.testing.assert_close(reversed_, source.flip(0))
2026-11-13T09:27:42.3954939Z 
