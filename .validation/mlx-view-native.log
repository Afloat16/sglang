2026-11-13T09:27:42.4128687Z     def test_cpu_float64_positive_stride_export_remains_zero_copy(self):
2026-11-13T09:27:42.4128971Z         import mlx.core as mx
2026-11-13T09:27:42.4129100Z 
2026-11-13T09:27:42.4129171Z         with mx.stream(mx.cpu):
2026-11-13T09:27:42.4129372Z             base = mx.arange(8).astype(mx.float64)
2026-11-13T09:27:42.4129616Z             array = base[::2]
2026-11-13T09:27:42.4129816Z         tensor = mlx_to_torch(array, device="cpu")
2026-11-13T09:27:42.4130063Z         self.assertEqual(tensor.stride(), (2,))
2026-11-13T09:27:42.4130388Z 
2026-11-13T09:27:42.4130475Z         tensor.fill_(11)
2026-11-13T09:27:42.4130674Z         torch.testing.assert_close(
2026-11-13T09:27:42.4130957Z             torch.utils.dlpack.from_dlpack(array.__dlpack__(dl_device=(1, 0))),
2026-11-13T09:27:42.4131382Z             torch.full((4,), 11, dtype=torch.float64),
2026-11-13T09:27:42.4131604Z         )
2026-11-13T09:27:42.4131693Z 
2026-11-13T09:27:42.4131812Z     def test_cpu_export_consumes_the_dlpack_capsule_once(self):
2026-11-13T09:27:42.4132244Z         """A DLPack capsule is single-use and must not be imported twice."""
2026-11-13T09:27:42.4132538Z         import mlx.core as mx
2026-11-13T09:27:42.4132697Z 
2026-11-13T09:27:42.4132822Z         with mx.stream(mx.cpu):
2026-11-13T09:27:42.4133058Z             array = mx.array([1.25, -2.5], dtype=mx.float32)
2026-11-13T09:27:42.4133412Z 
2026-11-13T09:27:42.4133496Z         with mock.patch.object(
2026-11-13T09:27:42.4133683Z             torch.utils.dlpack,
2026-11-13T09:27:42.4133875Z             "from_dlpack",
2026-11-13T09:27:42.4134163Z             wraps=torch.utils.dlpack.from_dlpack,
2026-11-13T09:27:42.4134530Z         ) as from_dlpack:
2026-11-13T09:27:42.4134734Z             tensor = mlx_to_torch(array, device="cpu")
2026-11-13T09:27:42.4134993Z 
2026-11-13T09:27:42.4135093Z         self.assertEqual(from_dlpack.call_count, 1)
2026-11-13T09:27:42.4135332Z         torch.testing.assert_close(
2026-11-13T09:27:42.4135619Z             tensor, torch.tensor([1.25, -2.5], dtype=torch.float32)
2026-11-13T09:27:42.4135915Z         )
2026-11-13T09:27:42.4136005Z 
2026-11-13T09:27:42.4136106Z     def test_explicit_cpu_target_shares_storage(self):
2026-11-13T09:27:42.4136343Z         import mlx.core as mx
2026-11-13T09:27:42.4136463Z 
2026-11-13T09:27:42.4136599Z         array = mx.arange(16, dtype=mx.float32).reshape(4, 4)[:, ::2]
2026-11-13T09:27:42.4136874Z         tensor = mlx_to_torch(array, device="cpu")
2026-11-13T09:27:42.4137022Z 
2026-11-13T09:27:42.4137123Z         self.assertEqual(tensor.device.type, "cpu")
2026-11-13T09:27:42.4137371Z         self.assertEqual(tensor.stride(), (4, 2))
2026-11-13T09:27:42.4137601Z         tensor.zero_()
