2026-11-13T09:42:32.6141031Z """LayerNorm follows its parameters after a module dtype conversion."""
2026-11-13T09:42:32.6141278Z 
2026-11-13T09:42:32.6141355Z import copy
2026-11-13T09:42:32.6141472Z import unittest
2026-11-13T09:42:32.6141612Z from unittest.mock import patch
2026-11-13T09:42:32.6141705Z 
2026-11-13T09:42:32.6141755Z import torch
2026-11-13T09:42:32.6141866Z from torch import nn
2026-11-13T09:42:32.6141939Z 
2026-11-13T09:42:32.6142009Z from sglang.kernels.spec import KernelBackend
2026-11-13T09:42:32.6142182Z from sglang.srt.layers import layernorm
2026-11-13T09:42:32.6142350Z from sglang.srt.layers.layernorm import LayerNorm
2026-11-13T09:42:32.6142541Z from sglang.test.ci.ci_register import register_cpu_ci
2026-11-13T09:42:32.6142729Z from sglang.test.test_utils import CustomTestCase
2026-11-13T09:42:32.6142837Z 
2026-11-13T09:42:32.6142916Z register_cpu_ci(est_time=10, suite="base-a-test-cpu")
2026-11-13T09:42:32.6143034Z 
2026-11-13T09:42:32.6143037Z 
2026-11-13T09:42:32.6143101Z def make_norm(dtype=torch.float32, *, bias=True):
2026-11-13T09:42:32.6143286Z     norm = LayerNorm(8, eps=1e-5, bias=bias, dtype=dtype)
2026-11-13T09:42:32.6143459Z     with torch.no_grad():
2026-11-13T09:42:32.6143632Z         norm.weight.copy_(torch.linspace(0.5, 1.4, 8, dtype=dtype))
2026-11-13T09:42:32.6143999Z         norm.bias.copy_(torch.linspace(-0.2, 0.3, 8, dtype=dtype))
2026-11-13T09:42:32.6144172Z     return norm
2026-11-13T09:42:32.6144235Z 
2026-11-13T09:42:32.6144237Z 
2026-11-13T09:42:32.6144289Z def reference_norm(norm):
2026-11-13T09:42:32.6144420Z     reference = nn.LayerNorm(
2026-11-13T09:42:32.6144614Z         8, eps=norm.variance_epsilon, bias=norm.use_bias, dtype=norm.weight.dtype
2026-11-13T09:42:32.6144814Z     )
2026-11-13T09:42:32.6144920Z     with torch.no_grad():
2026-11-13T09:42:32.6145061Z         reference.weight.copy_(norm.weight)
2026-11-13T09:42:32.6145213Z         if norm.use_bias:
2026-11-13T09:42:32.6145343Z             reference.bias.copy_(norm.bias)
2026-11-13T09:42:32.6145485Z     return reference
2026-11-13T09:42:32.6145554Z 
2026-11-13T09:42:32.6145557Z 
2026-11-13T09:42:32.6145605Z def data(dtype):
2026-11-13T09:42:32.6145719Z     return torch.tensor(
2026-11-13T09:42:32.6145835Z         [
2026-11-13T09:42:32.6146042Z             [-1.2, 0.3, 0.8, 1.7, -0.4, 0.6, -0.9, 1.1],
2026-11-13T09:42:32.6146207Z             [0.7, -0.2, 1.8, 0.4, -1.1, 0.2, 0.9, -0.6],
2026-11-13T09:42:32.6146351Z         ],
2026-11-13T09:42:32.6146454Z         dtype=dtype,
2026-11-13T09:42:32.6146564Z     )
2026-11-13T09:42:32.6146619Z 
2026-11-13T09:42:32.6146622Z 
2026-11-13T09:42:32.6146679Z class Projection(nn.Module):
2026-11-13T09:42:32.6146813Z     def __init__(self, norm):
2026-11-13T09:42:32.6146943Z         super().__init__()
2026-11-13T09:42:32.6147074Z         self.input = nn.Linear(8, 8)
2026-11-13T09:42:32.6147212Z         self.norm = norm
2026-11-13T09:42:32.6147341Z         self.output = nn.Linear(8, 3)
2026-11-13T09:42:32.6147435Z 
2026-11-13T09:42:32.6147484Z     def forward(self, x):
2026-11-13T09:42:32.6147605Z         x = self.input(x)
2026-11-13T09:42:32.6147739Z         if isinstance(self.norm, LayerNorm):
2026-11-13T09:42:32.6147909Z             x = self.norm(x, backend=KernelBackend.TORCH)
2026-11-13T09:42:32.6148061Z         else:
2026-11-13T09:42:32.6148170Z             x = self.norm(x)
2026-11-13T09:42:32.6148302Z         return self.output(x)
2026-11-13T09:42:32.6148383Z 
2026-11-13T09:42:32.6148388Z 
2026-11-13T09:42:32.6148465Z class TestLayerNormDtypeConversion(CustomTestCase):
2026-11-13T09:42:32.6148651Z     def test_standard_module_conversions(self):
2026-11-13T09:42:32.6148840Z         for conversion in ("half", "bfloat16", "double", "float"):
2026-11-13T09:42:32.6149062Z             with self.subTest(conversion=conversion):
2026-11-13T09:42:32.6149220Z                 norm = make_norm(
2026-11-13T09:42:32.6149396Z                     torch.float64 if conversion == "float" else torch.float32
2026-11-13T09:42:32.6149574Z                 )
2026-11-13T09:42:32.6149691Z                 getattr(norm, conversion)()
2026-11-13T09:42:32.6149848Z                 inputs = data(norm.weight.dtype)
2026-11-13T09:42:32.6150007Z                 reference = reference_norm(norm)
2026-11-13T09:42:32.6150317Z                 actual = norm(inputs, backend=KernelBackend.TORCH)
2026-11-13T09:42:32.6150552Z                 torch.testing.assert_close(actual, reference(inputs), rtol=0, atol=0)
2026-11-13T09:42:32.6150783Z                 self.assertEqual(actual.dtype, inputs.dtype)
2026-11-13T09:42:32.6150917Z 
2026-11-13T09:42:32.6150994Z     def test_mixed_input_dtype_after_conversion(self):
2026-11-13T09:42:32.6151167Z         for parameter_dtype, input_dtype in (
2026-11-13T09:42:32.6151323Z             (torch.float16, torch.float32),
2026-11-13T09:42:32.6151475Z             (torch.bfloat16, torch.float32),
2026-11-13T09:42:32.6151622Z             (torch.float64, torch.float32),
2026-11-13T09:42:32.6151769Z             (torch.float32, torch.bfloat16),
2026-11-13T09:42:32.6151906Z         ):
2026-11-13T09:42:32.6152065Z             with self.subTest(parameters=parameter_dtype, inputs=input_dtype):
2026-11-13T09:42:32.6152288Z                 norm = make_norm(torch.float64).to(parameter_dtype)
2026-11-13T09:42:32.6152467Z                 inputs = data(input_dtype)
2026-11-13T09:42:32.6152613Z                 before = inputs.clone()
2026-11-13T09:42:32.6152917Z                 expected = reference_norm(norm)(inputs.to(parameter_dtype)).to(
2026-11-13T09:42:32.6153111Z                     input_dtype
2026-11-13T09:42:32.6153235Z                 )
2026-11-13T09:42:32.6153361Z                 actual = norm.forward_native(inputs)
2026-11-13T09:42:32.6153557Z                 torch.testing.assert_close(actual, expected, rtol=0, atol=0)
2026-11-13T09:42:32.6153783Z                 torch.testing.assert_close(inputs, before, rtol=0, atol=0)
2026-11-13T09:42:32.6153989Z                 self.assertEqual(actual.dtype, input_dtype)
2026-11-13T09:42:32.6154104Z 
2026-11-13T09:42:32.6154209Z     def test_unconverted_float32_norm_keeps_mixed_precision_behavior(self):
2026-11-13T09:42:32.6154407Z         norm = make_norm()
2026-11-13T09:42:32.6154572Z         for dtype in (torch.float16, torch.bfloat16, torch.float32):
2026-11-13T09:42:32.6154838Z             with self.subTest(dtype=dtype):
2026-11-13T09:42:32.6154990Z                 inputs = data(dtype)
2026-11-13T09:42:32.6155165Z                 expected = reference_norm(norm)(inputs.float()).to(dtype)
2026-11-13T09:42:32.6155378Z                 torch.testing.assert_close(
2026-11-13T09:42:32.6155553Z                     norm.forward_native(inputs), expected, rtol=0, atol=0
2026-11-13T09:42:32.6155722Z                 )
2026-11-13T09:42:32.6155785Z 
2026-11-13T09:42:32.6155844Z     def test_converted_biasless_norm(self):
2026-11-13T09:42:32.6155996Z         norm = make_norm(bias=False).double()
2026-11-13T09:42:32.6156146Z         inputs = data(torch.float64)
2026-11-13T09:42:32.6156287Z         torch.testing.assert_close(
2026-11-13T09:42:32.6156485Z             norm.forward_native(inputs), reference_norm(norm)(inputs), rtol=0, atol=0
2026-11-13T09:42:32.6156683Z         )
2026-11-13T09:42:32.6156742Z 
2026-11-13T09:42:32.6156843Z     def test_checkpoint_assignment_uses_assigned_parameter_dtype(self):
2026-11-13T09:42:32.6157048Z         saved = make_norm().double().state_dict()
2026-11-13T09:42:32.6157207Z         norm = LayerNorm(8, eps=1e-5)
2026-11-13T09:42:32.6157359Z         norm.load_state_dict(saved, assign=True)
2026-11-13T09:42:32.6157538Z         self.assertEqual(norm.weight.dtype, torch.float64)
2026-11-13T09:42:32.6157710Z         inputs = data(torch.float64)
2026-11-13T09:42:32.6157850Z         torch.testing.assert_close(
2026-11-13T09:42:32.6158046Z             norm.forward_native(inputs), reference_norm(norm)(inputs), rtol=0, atol=0
2026-11-13T09:42:32.6158240Z         )
2026-11-13T09:42:32.6158299Z 
2026-11-13T09:42:32.6158387Z     def test_three_native_training_updates_match_pytorch(self):
2026-11-13T09:42:32.6158598Z         for dtype in (torch.float16, torch.bfloat16, torch.float64):
2026-11-13T09:42:32.6158784Z             with self.subTest(dtype=dtype):
2026-11-13T09:42:32.6158935Z                 torch.manual_seed(19)
2026-11-13T09:42:32.6159095Z                 model = Projection(make_norm()).to(dtype)
2026-11-13T09:42:32.6159266Z                 reference = copy.deepcopy(model)
2026-11-13T09:42:32.6159441Z                 reference.norm = reference_norm(model.norm)
2026-11-13T09:42:32.6159607Z                 optimizers = [
2026-11-13T09:42:32.6159766Z                     torch.optim.SGD(model.parameters(), lr=0.02),
2026-11-13T09:42:32.6159966Z                     torch.optim.SGD(reference.parameters(), lr=0.02),
2026-11-13T09:42:32.6160274Z                 ]
2026-11-13T09:42:32.6160389Z                 inputs = data(dtype)
2026-11-13T09:42:32.6160561Z                 target = torch.tensor([[0.2, -0.4, 0.6], [-0.1, 0.5, 0.3]])
2026-11-13T09:42:32.6160762Z                 before = model.norm.weight.detach().clone()
2026-11-13T09:42:32.6160927Z                 for _ in range(3):
2026-11-13T09:42:32.6161069Z                     actual = model(inputs)
2026-11-13T09:42:32.6161222Z                     expected = reference(inputs)
2026-11-13T09:42:32.6161417Z                     torch.testing.assert_close(actual, expected, rtol=0, atol=0)
2026-11-13T09:42:32.6161752Z                     for output, optimizer in zip((actual, expected), optimizers):
2026-11-13T09:42:32.6161950Z                         optimizer.zero_grad()
2026-11-13T09:42:32.6162131Z                         (output.float() - target).square().mean().backward()
2026-11-13T09:42:32.6162347Z                     expected_parameters = dict(reference.named_parameters())
2026-11-13T09:42:32.6162558Z                     for name, parameter in model.named_parameters():
2026-11-13T09:42:32.6162740Z                         torch.testing.assert_close(
2026-11-13T09:42:32.6162902Z                             parameter.grad,
2026-11-13T09:42:32.6163063Z                             expected_parameters[name].grad,
2026-11-13T09:42:32.6163223Z                             rtol=0,
2026-11-13T09:42:32.6163355Z                             atol=0,
2026-11-13T09:42:32.6163485Z                         )
2026-11-13T09:42:32.6163697Z                     for optimizer in optimizers:
2026-11-13T09:42:32.6163852Z                         optimizer.step()
2026-11-13T09:42:32.6164021Z                     for name, parameter in model.named_parameters():
2026-11-13T09:42:32.6164201Z                         torch.testing.assert_close(
2026-11-13T09:42:32.6164387Z                             parameter, expected_parameters[name], rtol=0, atol=0
2026-11-13T09:42:32.6164565Z                         )
2026-11-13T09:42:32.6164727Z                 self.assertFalse(torch.equal(model.norm.weight, before))
2026-11-13T09:42:32.6164860Z 
2026-11-13T09:42:32.6164956Z     def test_cuda_gate_rejects_converted_non_float32_parameters(self):
2026-11-13T09:42:32.6165198Z         # Only dispatch eligibility is exercised on CPU; no fused GPU op runs.
2026-11-13T09:42:32.6165448Z         with patch.object(layernorm, "_flashinfer_layernorm_available", True):
2026-11-13T09:42:32.6165683Z             for dtype in (torch.float16, torch.bfloat16, torch.float64):
2026-11-13T09:42:32.6165882Z                 with self.subTest(dtype=dtype):
2026-11-13T09:42:32.6166044Z                     norm = make_norm().to(dtype)
2026-11-13T09:42:32.6166201Z                     inputs = data(torch.bfloat16)
2026-11-13T09:42:32.6166407Z                     expected = reference_norm(norm)(inputs.to(dtype)).to(inputs.dtype)
2026-11-13T09:42:32.6166617Z                     torch.testing.assert_close(
2026-11-13T09:42:32.6166799Z                         norm.forward_cuda(inputs), expected, rtol=0, atol=0
2026-11-13T09:42:32.6166973Z                     )
2026-11-13T09:42:32.6167042Z 
2026-11-13T09:42:32.6167231Z     def test_hip_gate_rejects_parameters_converted_away_from_input_dtype(self):
2026-11-13T09:42:32.6167632Z         # An old constructor dtype must not make incompatible operands eligible.
2026-11-13T09:42:32.6168018Z         with patch.object(layernorm, "_has_aiter_layer_norm", True):
2026-11-13T09:42:32.6168328Z             norm = make_norm(torch.float16).float()
2026-11-13T09:42:32.6168587Z             inputs = data(torch.float16)
2026-11-13T09:42:32.6168796Z             expected = reference_norm(norm)(inputs.float()).half()
2026-11-13T09:42:32.6168981Z             torch.testing.assert_close(
2026-11-13T09:42:32.6169155Z                 norm.forward_hip(inputs), expected, rtol=0, atol=0
2026-11-13T09:42:32.6169321Z             )
