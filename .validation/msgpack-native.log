2026-11-13T10:04:39.0811872Z def _round_trip_values(values):
2026-11-13T10:04:39.0812185Z     wrapped = pickle_unfaithful_values(values)
2026-11-13T10:04:39.0812525Z     forwarded = msgspec.msgpack.decode(
2026-11-13T10:04:39.0812965Z         msgspec.msgpack.encode(wrapped, enc_hook=enc_hook), ext_hook=ext_hook
2026-11-13T10:04:39.0813386Z     )
2026-11-13T10:04:39.0813812Z     # A forwarding process re-encodes the packet without unwrapping its values.
2026-11-13T10:04:39.0814366Z     received = msgspec.msgpack.decode(
2026-11-13T10:04:39.0814900Z         msgspec.msgpack.encode(forwarded, enc_hook=enc_hook), ext_hook=ext_hook
2026-11-13T10:04:39.0815547Z     )
2026-11-13T10:04:39.0815837Z     return unpickle_values(received)
2026-11-13T10:04:39.0816040Z 
2026-11-13T10:04:39.0816045Z 
2026-11-13T10:04:39.0816220Z class TestMsgpackValueFaithfulness(unittest.TestCase):
2026-11-13T10:04:39.0816670Z     def test_integers_outside_msgpack_range_round_trip(self):
2026-11-13T10:04:39.0817119Z         for value in (-(1 << 63) - 1, 1 << 64, -(1 << 200), (1 << 256) - 1):
2026-11-13T10:04:39.0817655Z             for container in ("scalar", "flat_list", "nested_dict"):
2026-11-13T10:04:39.0818129Z                 with self.subTest(value=value, container=container):
2026-11-13T10:04:39.0818704Z                     item = {
2026-11-13T10:04:39.0818982Z                         "scalar": value,
2026-11-13T10:04:39.0819289Z                         "flat_list": [0, value, 1],
2026-11-13T10:04:39.0819660Z                         "nested_dict": {"metadata": [0, {"id": value}]},
2026-11-13T10:04:39.0820037Z                     }[container]
2026-11-13T10:04:39.0820383Z                     self.assertEqual(_round_trip_values([item]), [item])
2026-11-13T10:04:39.0820667Z 
2026-11-13T10:04:39.0820862Z     def test_representable_integers_keep_native_wire_format(self):
2026-11-13T10:04:39.0821352Z         values = [-(1 << 63), -1, 0, (1 << 63) - 1, (1 << 64) - 1, True, False]
2026-11-13T10:04:39.0821760Z         wrapped = pickle_unfaithful_values(values)
2026-11-13T10:04:39.0822102Z         self.assertIs(wrapped, values)
2026-11-13T10:04:39.0822396Z         self.assertEqual(
2026-11-13T10:04:39.0822776Z             msgspec.msgpack.encode(wrapped), msgspec.msgpack.encode(values)
2026-11-13T10:04:39.0823173Z         )
2026-11-13T10:04:39.0823439Z         self.assertEqual(_round_trip_values(values), values)
2026-11-13T10:04:39.0823797Z         nested = [{"values": values}, values]
2026-11-13T10:04:39.0824179Z         self.assertIs(pickle_unfaithful_values(nested), nested)
2026-11-13T10:04:39.0824693Z 
2026-11-13T10:04:39.0824951Z     def test_structured_arrays_keep_fields_titles_and_layout(self):
2026-11-13T10:04:39.0825352Z         dtypes = (
2026-11-13T10:04:39.0825641Z             np.dtype([("token", "<i8"), ("score", "<f4")]),
2026-11-13T10:04:39.0825964Z             np.dtype(
2026-11-13T10:04:39.0826313Z                 [("box", "<f4", (4,)), ("stats", [("mean", "<f4"), ("count", "<i2")])]
2026-11-13T10:04:39.0826760Z             ),
2026-11-13T10:04:39.0826994Z             np.dtype(
2026-11-13T10:04:39.0827314Z                 [(("class title", "label"), ">i2"), ("weight", "<f8")], align=True
2026-11-13T10:04:39.0827674Z             ),
2026-11-13T10:04:39.0827906Z             np.dtype(
2026-11-13T10:04:39.0828127Z                 {
2026-11-13T10:04:39.0828362Z                     "names": ["left", "right"],
2026-11-13T10:04:39.0829166Z                     "formats": ["u1", "<f8"],
2026-11-13T10:04:39.0829473Z                     "offsets": [0, 16],
2026-11-13T10:04:39.0829761Z                     "itemsize": 32,
2026-11-13T10:04:39.0830029Z                 }
2026-11-13T10:04:39.0830431Z             ),
2026-11-13T10:04:39.0830635Z         )
2026-11-13T10:04:39.0830849Z         for dtype in dtypes:
2026-11-13T10:04:39.0831128Z             with self.subTest(dtype=dtype):
2026-11-13T10:04:39.0831464Z                 source = np.zeros(3, dtype=dtype)
2026-11-13T10:04:39.0831796Z                 source[source.dtype.names[0]] = 2
2026-11-13T10:04:39.0832126Z                 decoded = _round_trip_values([source])[0]
2026-11-13T10:04:39.0832499Z                 self.assertEqual(decoded.dtype, source.dtype)
2026-11-13T10:04:39.0832927Z                 self.assertEqual(decoded.dtype.descr, source.dtype.descr)
2026-11-13T10:04:39.0833326Z                 self.assertEqual(decoded.shape, source.shape)
2026-11-13T10:04:39.0833718Z                 np.testing.assert_array_equal(decoded, source)
2026-11-13T10:04:39.0834133Z                 self.assertFalse(np.shares_memory(decoded, source))
2026-11-13T10:04:39.0834405Z 
2026-11-13T10:04:39.0834700Z     def test_object_arrays_keep_python_values(self):
2026-11-13T10:04:39.0835004Z         source = np.empty((2, 2), dtype=object)
2026-11-13T10:04:39.0835649Z         source[0, 0] = {"label": "東京", "id": 1 << 100}
2026-11-13T10:04:39.0835910Z         source[0, 1] = (1, 2)
2026-11-13T10:04:39.0836130Z         source[1, 0] = None
2026-11-13T10:04:39.0836344Z         source[1, 1] = ["a", "b"]
2026-11-13T10:04:39.0836585Z         decoded = _round_trip_values([source])[0]
2026-11-13T10:04:39.0836885Z         self.assertEqual(decoded.dtype, source.dtype)
2026-11-13T10:04:39.0837208Z         self.assertEqual(decoded.shape, source.shape)
2026-11-13T10:04:39.0837546Z         self.assertEqual(decoded.tolist(), source.tolist())
2026-11-13T10:04:39.0837874Z         self.assertIsInstance(decoded[0, 1], tuple)
2026-11-13T10:04:39.0838143Z         source[0, 0]["label"] = "changed"
2026-11-13T10:04:39.0838707Z         self.assertEqual(decoded[0, 0]["label"], "東京")
2026-11-13T10:04:39.0838943Z 
2026-11-13T10:04:39.0839104Z     def test_dtype_metadata_and_zero_itemsize_arrays(self):
2026-11-13T10:04:39.0839431Z         for source in (
2026-11-13T10:04:39.0839755Z             np.array([1, 2], dtype=np.dtype("f4", metadata={"unit": "score"})),
2026-11-13T10:04:39.0840123Z             np.empty((2, 3), dtype="V0"),
2026-11-13T10:04:39.0840346Z         ):
2026-11-13T10:04:39.0840637Z             with self.subTest(dtype=source.dtype, itemsize=source.dtype.itemsize):
2026-11-13T10:04:39.0840946Z                 decoded = _round_trip_values([source])[0]
2026-11-13T10:04:39.0841200Z                 self.assertEqual(decoded.dtype, source.dtype)
2026-11-13T10:04:39.0841501Z                 self.assertEqual(decoded.dtype.metadata, source.dtype.metadata)
2026-11-13T10:04:39.0841798Z                 self.assertEqual(decoded.shape, source.shape)
2026-11-13T10:04:39.0842052Z                 np.testing.assert_array_equal(decoded, source)
2026-11-13T10:04:39.0842211Z 
2026-11-13T10:04:39.0842331Z     def test_plain_arrays_still_use_existing_buffer_extension(self):
2026-11-13T10:04:39.0842686Z         for source in (
2026-11-13T10:04:39.0842944Z             np.arange(12, dtype=np.float32).reshape(3, 4)[:, ::2],
2026-11-13T10:04:39.0843180Z             np.array(2, dtype=np.int64),
2026-11-13T10:04:39.0843388Z             np.empty((2, 0), dtype=np.float16),
2026-11-13T10:04:39.0843659Z             np.array(["a", "東京"], dtype="U2"),
2026-11-13T10:04:39.0843889Z             np.array(["2025-01-02"], dtype="datetime64[D]"),
2026-11-13T10:04:39.0844099Z         ):
2026-11-13T10:04:39.0844301Z             with self.subTest(dtype=source.dtype, shape=source.shape):
2026-11-13T10:04:39.0844554Z                 values = [source]
2026-11-13T10:04:39.0844787Z                 self.assertIs(pickle_unfaithful_values(values), values)
2026-11-13T10:04:39.0845044Z                 wrapped = enc_hook(source)
2026-11-13T10:04:39.0845261Z                 self.assertEqual(wrapped.code, 3)
2026-11-13T10:04:39.0845492Z                 decoded = _round_trip_values(values)[0]
2026-11-13T10:04:39.0845749Z                 self.assertEqual(decoded.dtype, source.dtype)
2026-11-13T10:04:39.0846009Z                 np.testing.assert_array_equal(decoded, source)
2026-11-13T10:04:39.0846173Z 
2026-11-13T10:04:39.0846277Z     def test_shared_fallback_array_keeps_one_object(self):
2026-11-13T10:04:39.0846580Z         source = np.array([(1, 0.25)], dtype=[("token", "<i4"), ("score", "<f4")])
2026-11-13T10:04:39.0846904Z         decoded = _round_trip_values([source, {"array": source}, source])
2026-11-13T10:04:39.0847194Z         self.assertIs(decoded[0], decoded[1]["array"])
2026-11-13T10:04:39.0847427Z         self.assertIs(decoded[0], decoded[2])
2026-11-13T10:04:39.0847672Z         np.testing.assert_array_equal(decoded[0], source)
