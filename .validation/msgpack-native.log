2026-11-13T10:04:39.0847939Z     def test_real_multimodal_request_survives_forwarding(self):
2026-11-13T10:04:39.0848179Z         records = np.array(
2026-11-13T10:04:39.0848541Z             [(7, 0.25), (9, 0.75)], dtype=[("token", "<i4"), ("score", "<f4")]
2026-11-13T10:04:39.0848872Z         )
2026-11-13T10:04:39.0849043Z         source_feature = torch.tensor([[1.0, 2.0]])
2026-11-13T10:04:39.0849358Z         request = TokenizedGenerateReqInput(
2026-11-13T10:04:39.0849593Z             input_text="",
2026-11-13T10:04:39.0849776Z             input_ids=array("q", [1, 2]),
2026-11-13T10:04:39.0849973Z             input_embeds=None,
2026-11-13T10:04:39.0850175Z             mm_inputs=MultimodalProcessorOutput(
2026-11-13T10:04:39.0850390Z                 mm_items=[
2026-11-13T10:04:39.0850570Z                     MultimodalDataItem(
2026-11-13T10:04:39.0850783Z                         modality=Modality.IMAGE,
2026-11-13T10:04:39.0851001Z                         feature=source_feature,
2026-11-13T10:04:39.0851206Z                         model_specific_data={
2026-11-13T10:04:39.0851412Z                             "records": records,
2026-11-13T10:04:39.0851625Z                             "large_id": 1 << 200,
2026-11-13T10:04:39.0851852Z                             "nested": {"records": records},
2026-11-13T10:04:39.0852059Z                         },
2026-11-13T10:04:39.0852217Z                     )
2026-11-13T10:04:39.0852365Z                 ]
2026-11-13T10:04:39.0852509Z             ),
2026-11-13T10:04:39.0852661Z             token_type_ids=[0, 0],
2026-11-13T10:04:39.0852862Z             sampling_params=SamplingParams(),
2026-11-13T10:04:39.0853069Z             return_logprob=False,
2026-11-13T10:04:39.0853255Z             logprob_start_len=0,
2026-11-13T10:04:39.0853452Z             top_logprobs_num=0,
2026-11-13T10:04:39.0853637Z             token_ids_logprob=None,
2026-11-13T10:04:39.0853826Z             stream=False,
2026-11-13T10:04:39.0853980Z         )
2026-11-13T10:04:39.0854172Z         with patch.object(io_struct, "_USE_PICKLE_IPC", False):
2026-11-13T10:04:39.0854424Z             request.wrap_pickle_fields()
2026-11-13T10:04:39.0854658Z             forwarded = msgpack_decode(msgpack_encode(request))
2026-11-13T10:04:39.0854998Z             decoded = msgpack_decode(msgpack_encode(forwarded))
2026-11-13T10:04:39.0855239Z             decoded.unwrap_pickle_fields()
2026-11-13T10:04:39.0855451Z         item = decoded.mm_inputs.mm_items[0]
2026-11-13T10:04:39.0855722Z         self.assertIsInstance(decoded, TokenizedGenerateReqInput)
2026-11-13T10:04:39.0856043Z         self.assertEqual(item.model_specific_data["large_id"], 1 << 200)
2026-11-13T10:04:39.0856395Z         self.assertEqual(item.model_specific_data["records"].dtype, records.dtype)
2026-11-13T10:04:39.0856769Z         np.testing.assert_array_equal(item.model_specific_data["records"], records)
2026-11-13T10:04:39.0857057Z         self.assertIs(
2026-11-13T10:04:39.0857235Z             item.model_specific_data["records"],
2026-11-13T10:04:39.0857459Z             item.model_specific_data["nested"]["records"],
2026-11-13T10:04:39.0857662Z         )
2026-11-13T10:04:39.0857876Z         torch.testing.assert_close(item.feature, source_feature, rtol=0, atol=0)
