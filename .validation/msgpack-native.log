2026-11-13T10:04:39.0809411Z from sglang.srt.utils.msgpack_utils import (
2026-11-13T10:04:39.0809740Z     enc_hook,
2026-11-13T10:04:39.0810000Z     ext_hook,
2026-11-13T10:04:39.0810303Z     pickle_unfaithful_values,
2026-11-13T10:04:39.0810595Z     unpickle_values,
2026-11-13T10:04:39.0810823Z )
2026-11-13T10:04:39.0811093Z from sglang.test.ci.ci_register import register_cpu_ci
2026-11-13T10:04:39.0811347Z 
2026-11-13T10:04:39.0811508Z register_cpu_ci(est_time=5, suite="base-a-test-cpu")
