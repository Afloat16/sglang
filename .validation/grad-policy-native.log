2026-11-13T09:34:50.5408003Z     def test_native_model_inference_then_training_updates(self):
2026-11-13T09:34:50.5408644Z         DynamicGradMode.set_inference_mode(False)
2026-11-13T09:34:50.5409200Z         model = nn.Linear(3, 2, dtype=torch.float64)
2026-11-13T09:34:50.5409707Z         with torch.no_grad():
2026-11-13T09:34:50.5410335Z             model.weight.copy_(torch.arange(6, dtype=torch.float64).reshape(2, 3) / 8)
2026-11-13T09:34:50.5411225Z             model.bias.copy_(torch.tensor([0.2, -0.3], dtype=torch.float64))
2026-11-13T09:34:50.5412145Z         reference = copy.deepcopy(model)
2026-11-13T09:34:50.5412844Z         optimizer = torch.optim.SGD(model.parameters(), lr=0.05)
2026-11-13T09:34:50.5413637Z         reference_optimizer = torch.optim.SGD(reference.parameters(), lr=0.05)
2026-11-13T09:34:50.5414500Z         inputs = torch.tensor([[1.0, -2.0, 0.5], [-1.5, 0.2, 2.0]], dtype=torch.float64)
2026-11-13T09:34:50.5415313Z         target = torch.tensor([[0.1, -0.4], [0.5, 0.7]], dtype=torch.float64)
2026-11-13T09:34:50.5416005Z 
2026-11-13T09:34:50.5416158Z         @DynamicGradMode()
2026-11-13T09:34:50.5416692Z         def predict():
2026-11-13T09:34:50.5417078Z             return model(inputs)
2026-11-13T09:34:50.5417343Z 
2026-11-13T09:34:50.5417525Z         for inference in (True, False, True):
2026-11-13T09:34:50.5418071Z             DynamicGradMode.set_inference_mode(inference)
2026-11-13T09:34:50.5418590Z             actual = predict()
2026-11-13T09:34:50.5419093Z             with torch.inference_mode(inference), torch.no_grad():
2026-11-13T09:34:50.5419672Z                 expected = reference(inputs)
2026-11-13T09:34:50.5420270Z             torch.testing.assert_close(actual, expected, rtol=0, atol=0)
2026-11-13T09:34:50.5420924Z             self.assertFalse(actual.requires_grad)
2026-11-13T09:34:50.5421501Z             self.assertEqual(actual.is_inference(), inference)
2026-11-13T09:34:50.5422301Z             self.assertTrue(model.training)
2026-11-13T09:34:50.5422789Z             self.assert_caller_restored()
2026-11-13T09:34:50.5423265Z             optimizer.zero_grad()
2026-11-13T09:34:50.5423710Z             reference_optimizer.zero_grad()
2026-11-13T09:34:50.5424260Z             (model(inputs) - target).square().mean().backward()
2026-11-13T09:34:50.5424903Z             (reference(inputs) - target).square().mean().backward()
2026-11-13T09:34:50.5425649Z             for left, right in zip(model.parameters(), reference.parameters()):
2026-11-13T09:34:50.5426336Z                 self.assertTrue(left.requires_grad)
2026-11-13T09:34:50.5427004Z                 torch.testing.assert_close(left.grad, right.grad, rtol=0, atol=0)
2026-11-13T09:34:50.5427657Z             optimizer.step()
2026-11-13T09:34:50.5428090Z             reference_optimizer.step()
2026-11-13T09:34:50.5428712Z             for left, right in zip(model.parameters(), reference.parameters()):
2026-11-13T09:34:50.5429468Z                 torch.testing.assert_close(left, right, rtol=0, atol=0)
2026-11-13T09:34:50.5429908Z 
