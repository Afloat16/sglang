2026-11-13T09:34:50.5350734Z class TestDynamicGradModePolicy(unittest.TestCase):
2026-11-13T09:34:50.5351276Z     def setUp(self):
2026-11-13T09:34:50.5352249Z         self.original_policy = common._ENABLE_TORCH_INFERENCE_MODE
2026-11-13T09:34:50.5353022Z         self.inference_guard = torch.inference_mode(False)
2026-11-13T09:34:50.5353604Z         self.inference_guard.__enter__()
2026-11-13T09:34:50.5354123Z         self.grad_guard = torch.enable_grad()
2026-11-13T09:34:50.5354625Z         self.grad_guard.__enter__()
2026-11-13T09:34:50.5354927Z 
2026-11-13T09:34:50.5355076Z     def tearDown(self):
2026-11-13T09:34:50.5355598Z         DynamicGradMode.set_inference_mode(self.original_policy)
2026-11-13T09:34:50.5356250Z         self.grad_guard.__exit__(None, None, None)
2026-11-13T09:34:50.5356798Z         self.inference_guard.__exit__(None, None, None)
2026-11-13T09:34:50.5357167Z 
2026-11-13T09:34:50.5357330Z     def assert_policy(self, inference):
2026-11-13T09:34:50.5357803Z         self.assertFalse(torch.is_grad_enabled())
2026-11-13T09:34:50.5358514Z         self.assertEqual(torch.is_inference_mode_enabled(), inference)
2026-11-13T09:34:50.5358937Z 
2026-11-13T09:34:50.5359104Z     def assert_caller_restored(self):
2026-11-13T09:34:50.5359612Z         self.assertTrue(torch.is_grad_enabled())
