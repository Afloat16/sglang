2026-11-13T10:58:33.3880344Z     def test_small_views_cannot_bypass_cache_admission(self):
2026-11-13T10:58:33.3880531Z         for use_memoryview in (False, True):
2026-11-13T10:58:33.3880708Z             with self.subTest(use_memoryview=use_memoryview):
2026-11-13T10:58:33.3880897Z                 owner = np.arange(16384, dtype=np.float32)
2026-11-13T10:58:33.3881073Z                 reference = weakref.ref(owner)
2026-11-13T10:58:33.3881228Z                 value = owner[:1]
2026-11-13T10:58:33.3881367Z                 if use_memoryview:
2026-11-13T10:58:33.3881516Z                     value = memoryview(value)
2026-11-13T10:58:33.3881729Z                 cache = MultimodalPreprocessCache(max_size_bytes=1024)
2026-11-13T10:58:33.3881940Z                 self.assertFalse(cache.put("image", value))
2026-11-13T10:58:33.3882135Z                 self.assertEqual(cache.stats()["size_bytes"], 0)
2026-11-13T10:58:33.3882316Z                 self.assertEqual(len(cache), 0)
2026-11-13T10:58:33.3882473Z                 del owner, value
2026-11-13T10:58:33.3882607Z                 gc.collect()
2026-11-13T10:58:33.3882748Z                 self.assertIsNone(reference())
2026-11-13T10:58:33.3882851Z 
2026-11-13T10:58:33.3882947Z     def test_byte_budget_eviction_releases_retained_numpy_owner(self):
2026-11-13T10:58:33.3883151Z         owner = np.arange(4096, dtype=np.float32)
2026-11-13T10:58:33.3883320Z         reference = weakref.ref(owner)
2026-11-13T10:58:33.3883509Z         cache = MultimodalPreprocessCache(max_size_bytes=owner.nbytes)
2026-11-13T10:58:33.3883725Z         self.assertTrue(cache.put("first", owner[:1]))
2026-11-13T10:58:33.3883882Z         del owner
2026-11-13T10:58:33.3883995Z         gc.collect()
2026-11-13T10:58:33.3884124Z         self.assertIsNotNone(reference())
2026-11-13T10:58:33.3884226Z 
2026-11-13T10:58:33.3884289Z         other = np.arange(4096, dtype=np.float32)
2026-11-13T10:58:33.3884467Z         self.assertTrue(cache.put("second", other[-1:]))
2026-11-13T10:58:33.3884630Z         gc.collect()
2026-11-13T10:58:33.3884760Z         self.assertIsNone(reference())
2026-11-13T10:58:33.3884911Z         self.assertNotIn("first", cache)
2026-11-13T10:58:33.3885062Z         self.assertIn("second", cache)
2026-11-13T10:58:33.3885241Z         self.assertEqual(cache.stats()["size_bytes"], other.nbytes)
2026-11-13T10:58:33.3885448Z         self.assertEqual(cache.stats()["evictions"], 1)
2026-11-13T10:58:33.3885723Z         np.testing.assert_array_equal(cache.get("second"), other[-1:])
2026-11-13T10:58:33.3885862Z 
2026-11-13T10:58:33.3886114Z     def test_singleflight_completion_uses_retained_buffer_admission(self):
2026-11-13T10:58:33.3886344Z         owner = np.arange(2048, dtype=np.float32)
2026-11-13T10:58:33.3886536Z         cache = MultimodalPreprocessCache(max_size_bytes=128)
2026-11-13T10:58:33.3886736Z         (miss,) = cache.lookup_or_claim_many(["image"])
2026-11-13T10:58:33.3886896Z         value = owner[:2]
2026-11-13T10:58:33.3887030Z         cache.complete_miss(miss, value)
2026-11-13T10:58:33.3887192Z         self.assertIs(miss.future.result(), value)
2026-11-13T10:58:33.3887375Z         self.assertEqual(cache.stats()["inflight"], 0)
2026-11-13T10:58:33.3887559Z         self.assertEqual(cache.stats()["size_bytes"], 0)
2026-11-13T10:58:33.3887729Z         self.assertNotIn("image", cache)
2026-11-13T10:58:33.3887827Z 
