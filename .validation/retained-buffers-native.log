2026-11-13T10:58:33.3868365Z class TestPreprocessRetainedBuffers(unittest.TestCase):
2026-11-13T10:58:33.3868583Z     def test_numpy_views_count_the_retained_allocation(self):
2026-11-13T10:58:33.3868779Z         owner = np.arange(8192, dtype=np.float32)
2026-11-13T10:58:33.3868943Z         original = owner.copy()
2026-11-13T10:58:33.3869076Z         views = [
2026-11-13T10:58:33.3869192Z             owner[:1],
2026-11-13T10:58:33.3869317Z             owner[17:43:3],
2026-11-13T10:58:33.3869482Z             owner[::-4],
2026-11-13T10:58:33.3869621Z             owner.reshape(64, 128).T[1:3, ::2],
2026-11-13T10:58:33.3869861Z             owner[:0],
2026-11-13T10:58:33.3869977Z         ]
2026-11-13T10:58:33.3870087Z         for value in views:
2026-11-13T10:58:33.3870264Z             with self.subTest(shape=value.shape, strides=value.strides):
2026-11-13T10:58:33.3870519Z                 self.assertEqual(estimate_cache_size_bytes(value), original.nbytes)
2026-11-13T10:58:33.3870786Z                 self.assertTrue(np.shares_memory(value, owner) or value.size == 0)
2026-11-13T10:58:33.3871016Z         np.testing.assert_array_equal(owner, original)
2026-11-13T10:58:33.3871133Z 
2026-11-13T10:58:33.3871236Z     def test_broadcast_and_stride_trick_wrappers_reach_the_owner(self):
2026-11-13T10:58:33.3871444Z         owner = np.arange(32, dtype=np.int16)
2026-11-13T10:58:33.3871595Z         values = [
2026-11-13T10:58:33.3871724Z             np.broadcast_to(owner[:1], (10000,)),
2026-11-13T10:58:33.3871891Z             np.lib.stride_tricks.as_strided(
2026-11-13T10:58:33.3872075Z                 owner, shape=(3, 2), strides=(8, 2), writeable=False
2026-11-13T10:58:33.3872245Z             ),
2026-11-13T10:58:33.3872394Z             np.lib.stride_tricks.sliding_window_view(owner, 3)[1:2],
2026-11-13T10:58:33.3872570Z         ]
2026-11-13T10:58:33.3872681Z         for value in values:
2026-11-13T10:58:33.3872826Z             with self.subTest(shape=value.shape):
2026-11-13T10:58:33.3873036Z                 self.assertEqual(estimate_cache_size_bytes(value), owner.nbytes)
2026-11-13T10:58:33.3873258Z                 self.assertFalse(value.flags.writeable)
2026-11-13T10:58:33.3873374Z 
2026-11-13T10:58:33.3873470Z     def test_memoryviews_count_owner_bytes_instead_of_elements(self):
