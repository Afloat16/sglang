2026-11-13T10:38:34.1322274Z class TestCpuRopeOffsets(unittest.TestCase):
2026-11-13T10:38:34.1322533Z     def setUp(self):
2026-11-13T10:38:34.1322737Z         self.backends = ExitStack()
