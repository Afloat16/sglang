2026-11-13T10:38:34.1362153Z     def test_attention_outputs_and_input_gradients(self):
2026-11-13T10:38:34.1362491Z         rope = RotaryEmbedding(8, 4, 64, 10000, True, torch.float64)
2026-11-13T10:38:34.1362798Z         positions = torch.tensor([1, 4, 7, 15])
2026-11-13T10:38:34.1363058Z         offsets = torch.tensor([1, 5, 0, 3])
2026-11-13T10:38:34.1363323Z         query, key = tensors(torch.float64, heads=1)
2026-11-13T10:38:34.1363585Z         query.requires_grad_()
2026-11-13T10:38:34.1363799Z         key.requires_grad_()
2026-11-13T10:38:34.1364067Z         reference_query = query.detach().clone().requires_grad_()
2026-11-13T10:38:34.1364400Z         reference_key = key.detach().clone().requires_grad_()
2026-11-13T10:38:34.1364760Z         actual_q, actual_k = rope.forward_cpu(positions, query, key, offsets)
2026-11-13T10:38:34.1365187Z         expected_q = reference_rotation(reference_query, rope, positions + offsets)
2026-11-13T10:38:34.1365626Z         expected_k = reference_rotation(reference_key, rope, positions + offsets)
2026-11-13T10:38:34.1366043Z         values = torch.arange(12, dtype=torch.float64).reshape(1, 4, 3) / 12
2026-11-13T10:38:34.1366379Z         actual = F.scaled_dot_product_attention(
2026-11-13T10:38:34.1366686Z             actual_q.transpose(0, 1), actual_k.transpose(0, 1), values
2026-11-13T10:38:34.1366968Z         )
2026-11-13T10:38:34.1367159Z         expected = F.scaled_dot_product_attention(
2026-11-13T10:38:34.1367485Z             expected_q.transpose(0, 1), expected_k.transpose(0, 1), values
2026-11-13T10:38:34.1367783Z         )
2026-11-13T10:38:34.1368014Z         torch.testing.assert_close(actual, expected, rtol=0, atol=0)
2026-11-13T10:38:34.1368428Z         actual.square().sum().backward()
2026-11-13T10:38:34.1368678Z         expected.square().sum().backward()
2026-11-13T10:38:34.1369029Z         torch.testing.assert_close(query.grad, reference_query.grad, rtol=0, atol=0)
2026-11-13T10:38:34.1369477Z         torch.testing.assert_close(key.grad, reference_key.grad, rtol=0, atol=0)
