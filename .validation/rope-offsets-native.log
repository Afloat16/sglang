2026-11-13T10:38:34.1324122Z         self.backends.enter_context(patch.object(base, "_is_cpu_amx_available", False))
2026-11-13T10:38:34.1324501Z         self.backends.enter_context(
2026-11-13T10:38:34.1324804Z             patch.object(rope_variant, "_is_cpu_amx_available", False)
2026-11-13T10:38:34.1325430Z         )
