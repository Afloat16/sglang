2026-11-13T10:38:34.1313875Z def reference_rotation(x, rope, indices):
2026-11-13T10:38:34.1314226Z     """Build each rotated coordinate independently from the selected cache row."""
2026-11-13T10:38:34.1314594Z     cache = rope.cos_sin_cache[indices].to(x.dtype)
2026-11-13T10:38:34.1314869Z     cos, sin = cache.chunk(2, dim=-1)
2026-11-13T10:38:34.1316384Z     cos, sin = cos.unsqueeze(-2), sin.unsqueeze(-2)
2026-11-13T10:38:34.1316885Z     half = rope.rotary_dim // 2
2026-11-13T10:38:34.1317107Z     if rope.is_neox_style:
2026-11-13T10:38:34.1317369Z         left, right = x[..., :half], x[..., half : rope.rotary_dim]
2026-11-13T10:38:34.1317727Z     else:
2026-11-13T10:38:34.1317983Z         left, right = x[..., : rope.rotary_dim : 2], x[..., 1 : rope.rotary_dim : 2]
2026-11-13T10:38:34.1318467Z     rotated_left = left * cos - right * sin
2026-11-13T10:38:34.1318735Z     rotated_right = right * cos + left * sin
2026-11-13T10:38:34.1318981Z     if rope.is_neox_style:
2026-11-13T10:38:34.1319368Z         rotated = torch.cat((rotated_left, rotated_right), dim=-1)
2026-11-13T10:38:34.1319655Z     else:
2026-11-13T10:38:34.1319939Z         rotated = torch.stack((rotated_left, rotated_right), dim=-1).flatten(-2)
2026-11-13T10:38:34.1320334Z     return torch.cat((rotated, x[..., rope.rotary_dim :]), dim=-1)
2026-11-13T10:38:34.1320557Z 
2026-11-13T10:38:34.1320562Z 
2026-11-13T10:38:34.1320702Z def tensors(dtype, tokens=4, heads=3, head_size=8):
2026-11-13T10:38:34.1321068Z     query = torch.linspace(-1.3, 1.7, tokens * heads * head_size, dtype=dtype)
2026-11-13T10:38:34.1321465Z     key = torch.linspace(1.1, -0.9, tokens * head_size, dtype=dtype)
2026-11-13T10:38:34.1321873Z     return query.reshape(tokens, heads, head_size), key.reshape(tokens, 1, head_size)
