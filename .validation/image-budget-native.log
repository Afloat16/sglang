2026-11-13T10:34:24.3475146Z """Dynamic-resolution budgets for images with a minimum-sized short side."""
2026-11-13T10:34:24.3475387Z 
2026-11-13T10:34:24.3475466Z import unittest
2026-11-13T10:34:24.3475565Z 
2026-11-13T10:34:24.3475647Z import torch
2026-11-13T10:34:24.3475813Z import torch.nn.functional as F
2026-11-13T10:34:24.3476002Z from PIL import Image
2026-11-13T10:34:24.3476108Z 
2026-11-13T10:34:24.3476214Z from sglang.srt.multimodal.internvl_utils import (
2026-11-13T10:34:24.3476481Z     compute_budgeted_image_sizes,
2026-11-13T10:34:24.3476674Z     compute_dynamic_image_size,
2026-11-13T10:34:24.3476856Z     resize_image_to_pixels,
2026-11-13T10:34:24.3477028Z )
2026-11-13T10:34:24.3477210Z from sglang.test.ci.ci_register import register_cpu_ci
2026-11-13T10:34:24.3477371Z 
2026-11-13T10:34:24.3477482Z register_cpu_ci(est_time=3, suite="base-a-test-cpu")
2026-11-13T10:34:24.3477691Z 
2026-11-13T10:34:24.3477695Z 
2026-11-13T10:34:24.3477808Z class TestDynamicImagePatchBudget(unittest.TestCase):
2026-11-13T10:34:24.3478262Z     def test_extreme_landscape_and_portrait_fit_the_patch_limit(self):
2026-11-13T10:34:24.3478550Z         for max_patches in (4, 16, 64, 256):
2026-11-13T10:34:24.3478780Z             for portrait in (False, True):
2026-11-13T10:34:24.3479057Z                 with self.subTest(max_patches=max_patches, portrait=portrait):
2026-11-13T10:34:24.3479360Z                     size = (16, 16384) if portrait else (16384, 16)
2026-11-13T10:34:24.3479892Z                     result = compute_dynamic_image_size(*size, 16, 0.5, 4, max_patches)
2026-11-13T10:34:24.3480198Z                     long_side = (max_patches // 2) * 16
2026-11-13T10:34:24.3480419Z                     expected = (
2026-11-13T10:34:24.3480629Z                         (32, long_side, max_patches // 4)
2026-11-13T10:34:24.3480851Z                         if portrait
2026-11-13T10:34:24.3481071Z                         else (long_side, 32, max_patches // 4)
2026-11-13T10:34:24.3481293Z                     )
2026-11-13T10:34:24.3481479Z                     self.assertEqual(result, expected)
2026-11-13T10:34:24.3481620Z 
2026-11-13T10:34:24.3481760Z     def test_supported_downsampling_grids_keep_both_constraints(self):
2026-11-13T10:34:24.3482107Z         for ds in (1, 2, 4):
2026-11-13T10:34:24.3482297Z             for portrait in (False, True):
2026-11-13T10:34:24.3482529Z                 with self.subTest(ds=ds, portrait=portrait):
2026-11-13T10:34:24.3482786Z                     size = (1, 16384) if portrait else (16384, 1)
2026-11-13T10:34:24.3483059Z                     width, height, tokens = compute_dynamic_image_size(
2026-11-13T10:34:24.3483321Z                         *size, 16, 1 / ds, ds * ds, 256
2026-11-13T10:34:24.3483520Z                     )
2026-11-13T10:34:24.3483705Z                     patches = (width // 16) * (height // 16)
2026-11-13T10:34:24.3483949Z                     self.assertLessEqual(patches, 256)
2026-11-13T10:34:24.3484192Z                     self.assertGreaterEqual(patches, ds * ds)
2026-11-13T10:34:24.3484437Z                     self.assertEqual(width % (16 * ds), 0)
2026-11-13T10:34:24.3484672Z                     self.assertEqual(height % (16 * ds), 0)
2026-11-13T10:34:24.3484928Z                     self.assertEqual(tokens, patches // (ds * ds))
2026-11-13T10:34:24.3485097Z 
2026-11-13T10:34:24.3485219Z     def test_non_grid_patch_limits_use_the_last_fitting_grid(self):
2026-11-13T10:34:24.3485482Z         for max_patches in (17, 63, 255):
2026-11-13T10:34:24.3485688Z             for portrait in (False, True):
2026-11-13T10:34:24.3485950Z                 with self.subTest(max_patches=max_patches, portrait=portrait):
2026-11-13T10:34:24.3486244Z                     size = (16, 16384) if portrait else (16384, 16)
2026-11-13T10:34:24.3486507Z                     width, height, tokens = compute_dynamic_image_size(
2026-11-13T10:34:24.3486755Z                         *size, 16, 0.5, 4, max_patches
2026-11-13T10:34:24.3486950Z                     )
2026-11-13T10:34:24.3487125Z                     patches = (width // 16) * (height // 16)
2026-11-13T10:34:24.3487379Z                     self.assertEqual(patches, max_patches // 4 * 4)
2026-11-13T10:34:24.3487635Z                     self.assertEqual(min(width, height), 32)
2026-11-13T10:34:24.3487877Z                     self.assertEqual(tokens, patches // 4)
2026-11-13T10:34:24.3488151Z 
2026-11-13T10:34:24.3488294Z     def test_multiple_extreme_images_fit_the_prompt_token_budget(self):
2026-11-13T10:34:24.3488562Z         sizes = [(16384, 16), (16, 16384)]
2026-11-13T10:34:24.3488767Z         original_sizes = sizes.copy()
2026-11-13T10:34:24.3489025Z         results = compute_budgeted_image_sizes(sizes, 128, 16, 0.5, 4, 512)
2026-11-13T10:34:24.3489329Z         self.assertEqual(results, [(2048, 32, 64), (32, 2048, 64)])
2026-11-13T10:34:24.3489630Z         self.assertEqual(sum(tokens for _, _, tokens in results), 128)
2026-11-13T10:34:24.3489907Z         self.assertEqual(sizes, original_sizes)
2026-11-13T10:34:24.3490049Z 
2026-11-13T10:34:24.3490195Z     def test_real_resized_pixels_and_downsampled_grid_fit_the_budget(self):
2026-11-13T10:34:24.3490515Z         for mode, size in (("RGB", (16384, 1)), ("L", (1, 16384))):
2026-11-13T10:34:24.3490754Z             with self.subTest(mode=mode):
2026-11-13T10:34:24.3490975Z                 image = Image.new(mode, size, color=127)
2026-11-13T10:34:24.3491198Z                 original = image.tobytes()
2026-11-13T10:34:24.3491442Z                 ((width, height, tokens),) = compute_budgeted_image_sizes(
2026-11-13T10:34:24.3491760Z                     [image.size], 64, 16, 0.5, 4, 256
2026-11-13T10:34:24.3491962Z                 )
2026-11-13T10:34:24.3492126Z                 pixels = resize_image_to_pixels(
2026-11-13T10:34:24.3492367Z                     image, width, height, mean=(0, 0, 0), std=(1, 1, 1)
2026-11-13T10:34:24.3492592Z                 )
2026-11-13T10:34:24.3492787Z                 self.assertEqual(pixels.shape, (1, 3, height, width))
2026-11-13T10:34:24.3493068Z                 self.assertLessEqual(pixels.numel(), 3 * 16 * 16 * 256)
2026-11-13T10:34:24.3493343Z                 patch_grid = pixels.unfold(2, 16, 16).unfold(3, 16, 16)
2026-11-13T10:34:24.3493629Z                 patch_features = patch_grid.mean(dim=(-1, -2))
2026-11-13T10:34:24.3493937Z                 shuffled = F.pixel_unshuffle(patch_features, 2)
2026-11-13T10:34:24.3494249Z                 self.assertEqual(shuffled.shape[-2] * shuffled.shape[-1], tokens)
2026-11-13T10:34:24.3494540Z                 self.assertLessEqual(tokens, 64)
2026-11-13T10:34:24.3494785Z                 self.assertTrue(torch.isfinite(shuffled).all())
2026-11-13T10:34:24.3495027Z                 self.assertEqual(image.size, size)
2026-11-13T10:34:24.3495246Z                 self.assertEqual(image.mode, mode)
2026-11-13T10:34:24.3495487Z                 self.assertEqual(image.tobytes(), original)
2026-11-13T10:34:24.3495643Z 
2026-11-13T10:34:24.3495746Z     def test_ordinary_dimensions_keep_existing_sizes(self):
2026-11-13T10:34:24.3495967Z         cases = (
2026-11-13T10:34:24.3496128Z             ((1024, 768, 4, 256), (288, 224, 63)),
2026-11-13T10:34:24.3496323Z             ((128, 64, 4, 256), (128, 64, 8)),
2026-11-13T10:34:24.3496516Z             ((16, 16, 64, 256), (128, 128, 16)),
2026-11-13T10:34:24.3496704Z         )
2026-11-13T10:34:24.3496894Z         for (width, height, minimum, maximum), expected in cases:
2026-11-13T10:34:24.3497185Z             with self.subTest(size=(width, height), minimum=minimum):
2026-11-13T10:34:24.3497447Z                 actual = compute_dynamic_image_size(
2026-11-13T10:34:24.3497699Z                     width, height, 16, 0.5, minimum, maximum
2026-11-13T10:34:24.3497901Z                 )
2026-11-13T10:34:24.3498439Z                 self.assertEqual(actual, expected)
2026-11-13T10:34:24.3498673Z                 transposed = compute_dynamic_image_size(
2026-11-13T10:34:24.3498906Z                     height, width, 16, 0.5, minimum, maximum
2026-11-13T10:34:24.3499110Z                 )
2026-11-13T10:34:24.3499335Z                 self.assertEqual(transposed, (expected[1], expected[0], expected[2]))
2026-11-13T10:34:24.3499546Z 
2026-11-13T10:34:24.3499649Z     def test_empty_and_unconstrained_prompt_controls(self):
2026-11-13T10:34:24.3499956Z         self.assertEqual(compute_budgeted_image_sizes([], 128, 16, 0.5, 4, 256), [])
2026-11-13T10:34:24.3500234Z         self.assertEqual(
2026-11-13T10:34:24.3500473Z             compute_budgeted_image_sizes([(128, 64), (64, 128)], 32, 16, 0.5, 4, 256),
2026-11-13T10:34:24.3500747Z             [(128, 64, 8), (64, 128, 8)],
2026-11-13T10:34:24.3500923Z         )
2026-11-13T10:34:24.3500994Z 
2026-11-13T10:34:24.3500998Z 
2026-11-13T10:34:24.3501075Z if __name__ == "__main__":
